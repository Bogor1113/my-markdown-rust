{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMdEdit",
  "mainBinaryName": "mymdedit",
  "version": "1.0.88",
  "identifier": "com.dongyueshisan.mymdedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyMdEdit",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#1a1b1e",
        "decorations": false,
        "shadow": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --disable-breakpad"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost http: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; frame-src 'self' https: http: asset: data:; media-src 'self' https: http: asset: data: blob:; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "冬月十三",
    "copyright": "波哥自研",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document (MyMdEdit)",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  }
}
